DB_HOST=localhost
DB_PORT=3306
DB_NAME=autogestor_dms
DB_USER=root
DB_PASSWORD=
PORT=3001
SESSION_SECRET=cambia-esta-llave-en-produccion
# RNF-005: cierre de sesion automatico por inactividad (minutos)
SESSION_IDLE_MINUTES=15
CORS_ORIGIN=http://localhost:5173

# --- Facturacion electronica CFDI 4.0 (Facturama) ---
# sandbox | produccion
# true = folios fiscales ficticios sin tocar la API. Ponlo en false cuando
# el perfil fiscal de la cuenta este configurado (lugar de expedicion y CSD).
FACTURAMA_SIMULADO=true
FACTURAMA_ENTORNO=sandbox
# Credenciales del portal de Facturama. Sin ellas el sistema timbra en modo
# simulado: arma el CFDI igual pero genera un folio fiscal ficticio.
FACTURAMA_USUARIO=
FACTURAMA_PASSWORD=
# Codigo postal del lugar de expedicion del emisor (obligatorio para timbrar)
# Debe coincidir con un Lugar de expedicion dado de alta en el perfil fiscal
FACTURAMA_EMISOR_CP=86991
# Serie de los comprobantes
# Vacio = sin serie. Solo ponla si esta registrada en la sucursal.
FACTURAMA_SERIE=

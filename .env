# ---------------------------------------------------------------------------
# Variables de Docker Compose.
# Copia este archivo como .env  ->  cp .env.example .env
# Para desarrollo funciona tal cual: los valores por omision ya sirven.
# ---------------------------------------------------------------------------

# Base de datos
DB_NAME=autogestor_dms
DB_USER=autogestor
DB_PASSWORD=autogestor
MYSQL_ROOT_PASSWORD=root_autogestor

# Puertos publicados en tu equipo (cambialos si alguno ya esta ocupado)
DB_PUERTO_HOST=3307
API_PUERTO_HOST=3001
WEB_PUERTO_HOST=5173

# Sesion (RNF-004, RNF-005)
SESSION_SECRET=cambia-esta-llave-en-produccion
SESSION_IDLE_MINUTES=15

# Origen permitido por CORS: debe coincidir con la direccion de la interfaz
CORS_ORIGIN=http://localhost:5173

# Direccion de la API tal como la ve el navegador
VITE_API_URL=http://localhost:3001/api
# --- Facturacion electronica CFDI 4.0 (Facturama) ---
# sandbox | produccion
# true = folios fiscales ficticios sin tocar la API. Ponlo en false cuando
# el perfil fiscal de la cuenta este configurado (lugar de expedicion y CSD).
FACTURAMA_SIMULADO=false
FACTURAMA_ENTORNO=sandbox
# Credenciales del portal de Facturama. Vacias = modo simulado (folio ficticio).
FACTURAMA_USUARIO=leo64xl
FACTURAMA_PASSWORD=F0100BDLx0
# Codigo postal del lugar de expedicion del emisor
FACTURAMA_EMISOR_CP=86991
FACTURAMA_SERIE=
